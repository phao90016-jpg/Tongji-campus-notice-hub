@startuml usecase-v01
' ============================================================
' 校园待办中心 · v0.1 主链路用例图
' 用途：课堂讲解（8 分钟）与 v0.1 验收
' 完整用例见 usecase-overview.puml
' ============================================================
title v0.1 主链路：登录 → 同步 → 通知流

skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam usecase {
  BackgroundColor #F7FBFF
  BorderColor #2C5F8A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #2C5F8A
}

actor 学生 as STU
actor "定时调度器" as SCHED <<系统角色>>
actor "学校统一身份认证" as SSO <<外部系统>>
actor "开放平台数据接口" as OPEN <<外部系统>>

rectangle "校园待办中心 · v0.1" {
  usecase "UC-01 统一身份认证登录" as UC01
  usecase "UC-02 首次登录同步" as UC02
  usecase "UC-03 查看周课表" as UC03
  usecase "UC-06 查看考试安排" as UC06
  usecase "UC-08 浏览通知流" as UC08
  usecase "UC-09 查看通知详情" as UC09
  usecase "UC-14 手动导入通知" as UC14
  usecase "UC-15 抓取并去重入库" as UC15
}

STU --> UC01
STU --> UC03
STU --> UC06
STU --> UC08
STU --> UC09
STU --> UC14

SCHED --> UC02
SCHED --> UC15

SSO --> UC01
OPEN --> UC02

UC01 ..> UC02 : <<include>>

@enduml
