# 复制为 .env 后填写。.env 已加入 .gitignore，不得提交。
# 密钥与个人数据严禁进入提示词。

APP_ENV=dev
DATABASE_URL=sqlite:///./dev.db

# GitHub OAuth（v0.1）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# 邮件提醒（v0.2）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
